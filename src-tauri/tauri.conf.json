{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Billie",
  "version": "2.1.0",
  "identifier": "com.eduardoteranisi.billie",
  "build": {
    "frontendDist": "../frontend/dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev --workspace frontend",
    "beforeBuildCommand": "npm run build --workspace frontend"
  },
  "app": {
    "windows": [
      {
        "title": "Billie",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; object-src 'none'; base-uri 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMwQ0M5RDk2QkEwMzdGODkKUldTSmZ3TzZscDNNd0F4dEk0aWYwMkpnRmRiNFYyUTdBdjFrRTVTMHIrek9uRS9IeU5CeFZEeWwK",
      "endpoints": [
        "https://github.com/eduardoteranisi/billie-project/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
